          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(tdp_auth_attempts_total{result!=\"ok\"}[5m]))",
          "legendFormat": "{{result}}",
          "datasource": {
