# 生产环境变量模板。复制成 .env 再改值（.env 已在 .gitignore 里，不会被提交）。
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # 生成密钥
#
# 只要有一个必填项没设，docker-compose.prod.yml 会直接启动失败（:? 语法），
# 这是故意的：宁可起不来，也不要用默认密钥跑在公网上。

# ── 必填 ───────────────────────────────────────────────────────
# JWT 签名密钥。必须随机，泄露 = 任何人都能伪造 admin token。
TDP_JWT_SECRET=换成至少32位的随机串

# 数据库口令（容器内使用；不需要对外暴露端口）
POSTGRES_PASSWORD=换成强口令

# ── 演示账号（只读）─────────────────────────────────────────────
# 给面试官/HR 点页面用：viewer 角色，只能看，不能写。
# 留空则不创建。第一次 `up` 时由 init_db 写入，重复执行会重置口令。
TDP_DEMO_USER=demo
TDP_DEMO_PASSWORD=换成你能给的演示口令

# ── 可选（有默认值）────────────────────────────────────────────
# 限流：每窗口次数 / 窗口秒数。线上建议保持默认或更严。
TDP_RATE_LIMIT=600
TDP_RATE_LIMIT_WINDOW=60
TDP_LOG_LEVEL=INFO

# 链路追踪导出地址（不填则只在进程内产生 span，不导出）
# TDP_OTLP_ENDPOINT=http://otel-collector:4317
